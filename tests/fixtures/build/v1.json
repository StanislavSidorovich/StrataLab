   "sql": {
    "K1": "SELECT count(*) AS sales\nFROM build_kaiyo.gold_fact_sales\nWHERE sale_date >= DATE '2026-01-01' AND sale_date < DATE '2026-07-01'",
    "K2": "SELECT p.brand, SUM(f.revenue) AS revenue\nFROM build_kaiyo.gold_fact_sales f\nJOIN build_kaiyo.gold_dim_product p ON p.product_id = f.product_id\nWHERE f.sale_date >= DATE '2026-01-01' AND sale_date < DATE '2026-07-01'\nGROUP BY p.brand\nORDER BY revenue DESC",
    "K3": "SELECT -SUM(units) AS units_returned\nFROM build_kaiyo.gold_fact_sales\nWHERE units < 0 AND sale_date >= DATE '2025-01-01' AND sale_date < DATE '2026-01-01'",
    "K4": "SELECT c.region_name, SUM(f.revenue) AS revenue\nFROM build_kaiyo.gold_fact_sales f\nJOIN build_kaiyo.gold_dim_customer c ON c.customer_id = f.customer_id\nWHERE f.sale_date >= DATE '2026-01-01' AND sale_date < DATE '2026-07-01'\nGROUP BY c.region_name\nORDER BY revenue DESC",
    "K5": "SELECT c.customer_name, SUM(f.revenue) AS revenue\nFROM build_kaiyo.gold_fact_sales f\nJOIN build_kaiyo.gold_dim_customer c ON c.customer_id = f.customer_id\nWHERE c.chain_name = 'Minori'\n  AND f.sale_date >= DATE '2025-01-01' AND sale_date < DATE '2026-01-01'\nGROUP BY c.customer_name\nORDER BY revenue DESC\nLIMIT 1",
